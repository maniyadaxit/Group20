<?xml version="1.0" encoding="UTF-8"?>
<!-- Demonstration SOAP request only. The API key and identifiers are placeholders. -->
<soapenv:Envelope
    xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/"
    xmlns:pay="http://campuseats.org/paymentgateway">
  <soapenv:Header>
    <pay:AuthHeader>
      <pay:merchantId>CAMPUS_EATS_DEMO</pay:merchantId>
      <pay:apiKey>DEMO_API_KEY_REPLACE_ME</pay:apiKey>
    </pay:AuthHeader>
  </soapenv:Header>
  <soapenv:Body>
    <pay:ChargeRequest>
      <pay:studentId>usr_demo_001</pay:studentId>
      <pay:orderId>ord_demo_001</pay:orderId>
      <pay:amountCents>1450</pay:amountCents>
      <pay:paymentMethodId>pm_demo_card_4242</pay:paymentMethodId>
    </pay:ChargeRequest>
  </soapenv:Body>
</soapenv:Envelope>
