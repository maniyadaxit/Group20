# ==========================================
# Aurora Gems - Root Environment Configuration
# ==========================================

# Database Configuration
DB_NAME=aurora_gems_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_URL=jdbc:postgresql://localhost:5432/aurora_gems_db

# Spring Profile (dev | prod | test)
SPRING_PROFILES_ACTIVE=dev

# Server Port
PORT=8080

# Security - JWT (Replace with 256-bit secret in production)
JWT_SECRET=4f6b5a7336763979244226452948404d635166546a576e5a723475377821412544
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Razorpay Integration (Optional in mock mode)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost

# Upload Directory
APP_UPLOAD_DIR=./uploads
