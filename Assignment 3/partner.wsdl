<?xml version="1.0" encoding="UTF-8"?>
<!--
  partner.wsdl
  CampusEats — CS543 Assignment 3, Task 2

  Contract for the external SOAP partner "PayGate" — a third-party payment
  gateway. CampusEats' Payments Service (see Assignment 2, initiatePayment)
  binds to this WSDL to carry out the "charge" operation.
-->
<definitions name="PayGatePaymentService"
             targetNamespace="http://paygate-partner.com/payment/v1"
             xmlns:tns="http://paygate-partner.com/payment/v1"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             xmlns="http://schemas.xmlsoap.org/wsdl/">

  <!-- ================= TYPES ================= -->
  <types>
    <xsd:schema targetNamespace="http://paygate-partner.com/payment/v1"
                xmlns:tns="http://paygate-partner.com/payment/v1"
                xmlns:xsd="http://www.w3.org/2001/XMLSchema">

      <!-- Security header carried in soap:Header, not in the Body -->
      <xsd:element name="Credentials">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="apiKey" type="xsd:string"/>
            <xsd:element name="merchantId" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <!-- Request body -->
      <xsd:element name="ChargeRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="merchantRef" type="xsd:string">
              <xsd:annotation><xsd:documentation>CampusEats orderId, echoed back in the response for reconciliation</xsd:documentation></xsd:annotation>
            </xsd:element>
            <xsd:element name="amount" type="xsd:decimal"/>
            <xsd:element name="currency" type="xsd:string"/>
            <xsd:element name="paymentMethodToken" type="xsd:string">
              <xsd:annotation><xsd:documentation>Tokenised card/UPI handle — never a raw card number</xsd:documentation></xsd:annotation>
            </xsd:element>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <!-- Success response body -->
      <xsd:element name="ChargeResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="transactionId" type="xsd:string"/>
            <xsd:element name="status" type="xsd:string"/>
            <xsd:element name="authCode" type="xsd:string"/>
            <xsd:element name="amountCharged" type="xsd:decimal"/>
            <xsd:element name="timestamp" type="xsd:dateTime"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <!-- Fault detail body -->
      <xsd:element name="ChargeFault">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="faultCode" type="xsd:string">
              <xsd:annotation><xsd:documentation>e.g. CARD_DECLINED, GATEWAY_UNAVAILABLE, INVALID_TOKEN</xsd:documentation></xsd:annotation>
            </xsd:element>
            <xsd:element name="faultReason" type="xsd:string"/>
            <xsd:element name="merchantRef" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

    </xsd:schema>
  </types>

  <!-- ================= MESSAGES ================= -->
  <message name="ChargeRequestMessage">
    <part name="credentials" element="tns:Credentials"/>
    <part name="parameters" element="tns:ChargeRequest"/>
  </message>

  <message name="ChargeResponseMessage">
    <part name="parameters" element="tns:ChargeResponse"/>
  </message>

  <message name="ChargeFaultMessage">
    <part name="fault" element="tns:ChargeFault"/>
  </message>

  <!-- ================= PORT TYPE ================= -->
  <portType name="PaymentPortType">
    <operation name="charge">
      <documentation>Charge a tokenised payment method for a CampusEats order.</documentation>
      <input message="tns:ChargeRequestMessage"/>
      <output message="tns:ChargeResponseMessage"/>
      <fault name="PaymentFault" message="tns:ChargeFaultMessage"/>
    </operation>
  </portType>

  <!-- ================= BINDING (SOAP over HTTP) ================= -->
  <binding name="PaymentBinding" type="tns:PaymentPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>

    <operation name="charge">
      <soap:operation soapAction="http://paygate-partner.com/payment/v1/charge" style="document"/>
      <input>
        <soap:header message="tns:ChargeRequestMessage" part="credentials" use="literal"/>
        <soap:body parts="parameters" use="literal"/>
      </input>
      <output>
        <soap:body use="literal"/>
      </output>
      <fault name="PaymentFault">
        <soap:fault name="PaymentFault" use="literal"/>
      </fault>
    </operation>
  </binding>

  <!-- ================= SERVICE / PORT ================= -->
  <service name="PayGatePaymentService">
    <documentation>PayGate — external SOAP payment gateway partner for CampusEats.</documentation>
    <port name="PaymentPort" binding="tns:PaymentBinding">
      <soap:address location="https://api.paygate-partner.com/soap/v1/PaymentService"/>
    </port>
  </service>

</definitions>
